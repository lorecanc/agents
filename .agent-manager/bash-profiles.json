{
  "version": 1,
  "description": "Single source of truth for pipeline agents' permission.bash blocks. Each role expands to the concatenation of its profiles, in order (OpenCode: last matching rule wins). Apply with: node manage-agents/manage-agents.mjs pipeline sync-bash",
  "profiles": {
    "deny-all": {
      "description": "Deny everything not listed.",
      "rules": [
        ["*", "deny"]
      ]
    },
    "cd": {
      "description": "Allow changing directory.",
      "rules": [
        ["cd *", "allow"]
      ]
    },
    "build-tools": {
      "description": "Language runtimes, package managers, build and test runners.",
      "rules": [
        ["node *", "allow"],
        ["npm *", "allow"],
        ["npx *", "allow"],
        ["pnpm *", "allow"],
        ["yarn *", "allow"],
        ["bun *", "allow"],
        ["deno *", "allow"],
        ["python *", "allow"],
        ["python3 *", "allow"],
        ["pytest*", "allow"],
        ["uv *", "allow"],
        ["poetry *", "allow"],
        ["pip *", "allow"],
        ["pip3 *", "allow"],
        ["go *", "allow"],
        ["cargo *", "allow"],
        ["rustc *", "allow"],
        ["make*", "allow"],
        ["cmake *", "allow"],
        ["gradle *", "allow"],
        ["./gradlew*", "allow"],
        ["mvn *", "allow"],
        ["./mvnw*", "allow"],
        ["dotnet *", "allow"],
        ["bundle *", "allow"],
        ["rake*", "allow"],
        ["rspec*", "allow"],
        ["composer *", "allow"],
        ["php *", "allow"],
        ["swift *", "allow"],
        ["xcodebuild *", "allow"],
        ["xcrun *", "allow"],
        [".venv/bin/*", "allow"],
        ["venv/bin/*", "allow"],
        ["./node_modules/.bin/*", "allow"],
        ["node_modules/.bin/*", "allow"],
        ["tsc*", "allow"],
        ["tsx *", "allow"],
        ["ts-node *", "allow"],
        ["vitest*", "allow"],
        ["jest*", "allow"],
        ["mocha*", "allow"],
        ["ava*", "allow"],
        ["eslint*", "allow"],
        ["prettier*", "allow"],
        ["biome*", "allow"],
        ["oxlint*", "allow"],
        ["turbo *", "allow"],
        ["nx *", "allow"],
        ["corepack *", "allow"],
        ["ruff *", "allow"],
        ["black *", "allow"],
        ["isort *", "allow"],
        ["flake8*", "allow"],
        ["mypy*", "allow"],
        ["pyright*", "allow"],
        ["basedpyright*", "allow"],
        ["pylint*", "allow"],
        ["tox*", "allow"],
        ["nox*", "allow"],
        ["alembic *", "allow"],
        ["uvicorn *", "allow"],
        ["gunicorn *", "allow"],
        ["flask *", "allow"],
        ["django-admin *", "allow"],
        ["pdm *", "allow"],
        ["hatch *", "allow"],
        ["pipenv *", "allow"],
        ["conda *", "allow"],
        ["gofmt*", "allow"],
        ["golangci-lint*", "allow"],
        ["rustfmt*", "allow"],
        ["rustup *", "allow"],
        ["gcc *", "allow"],
        ["g++ *", "allow"],
        ["clang *", "allow"],
        ["clang++ *", "allow"],
        ["ninja*", "allow"],
        ["ctest*", "allow"],
        ["bazel *", "allow"],
        ["kotlinc*", "allow"],
        ["ktlint*", "allow"],
        ["detekt*", "allow"],
        ["flutter *", "allow"],
        ["dart *", "allow"],
        ["pod *", "allow"],
        ["fastlane *", "allow"],
        ["mix *", "allow"],
        ["elixir *", "allow"],
        ["zig *", "allow"],
        ["protoc*", "allow"],
        ["buf *", "allow"],
        ["prisma *", "allow"],
        ["drizzle-kit *", "allow"],
        ["sh *", "allow"],
        ["bash *", "allow"],
        ["zsh *", "allow"],
        ["./*.sh*", "allow"],
        ["scripts/*", "allow"],
        ["./scripts/*", "allow"],
        ["bin/*", "allow"],
        ["./bin/*", "allow"],
        ["NODE_ENV=* *", "allow"],
        ["CI=* *", "allow"],
        ["PYTHONPATH=* *", "allow"],
        ["PYTHONDONTWRITEBYTECODE=* *", "allow"],
        ["TMPDIR=* *", "allow"],
        ["TZ=* *", "allow"],
        ["LANG=* *", "allow"],
        ["LC_ALL=* *", "allow"],
        ["RUST_BACKTRACE=* *", "allow"],
        ["RUSTFLAGS=* *", "allow"],
        ["CGO_ENABLED=* *", "allow"],
        ["GOFLAGS=* *", "allow"],
        ["GOOS=* *", "allow"],
        ["GOARCH=* *", "allow"],
        ["PORT=* *", "allow"],
        ["FORCE_COLOR=* *", "allow"],
        ["NO_COLOR=* *", "allow"]
      ]
    },
    "test-runners-read": {
      "description": "Allow read-only test and typecheck execution for review roles.",
      "rules": [
        ["node --test*", "allow"],
        ["node --import tsx --test*", "allow"],
        ["npm test*", "allow"],
        ["npm run test*", "allow"],
        ["npm run typecheck*", "allow"],
        ["npm --prefix * test*", "allow"],
        ["npx tsc --noEmit*", "allow"],
        ["npx --prefix * tsc --noEmit*", "allow"],
        ["pnpm test*", "allow"],
        ["yarn test*", "allow"],
        ["bun test*", "allow"],
        ["pytest*", "allow"],
        [".venv/bin/pytest*", "allow"],
        ["venv/bin/pytest*", "allow"],
        ["uv run pytest*", "allow"],
        ["go test*", "allow"],
        ["cargo test*", "allow"],
        ["cargo check*", "allow"],
        ["vitest run*", "allow"],
        ["jest*", "allow"]
      ]
    },
    "fs-basic": {
      "description": "Create and remove directories/files inside the repo or scratch (rm-guard and pipeline-guard block root, wildcard, and outside-repo deletions).",
      "rules": [
        ["mkdir *", "allow"],
        ["rmdir *", "allow"],
        ["touch *", "allow"],
        ["chmod *", "allow"],
        ["mktemp*", "allow"],
        ["rm *", "allow"]
      ]
    },
    "fs-move": {
      "description": "Copy, move, and link files.",
      "rules": [
        ["cp *", "allow"],
        ["mv *", "allow"],
        ["ln *", "allow"]
      ]
    },
    "shell-read": {
      "description": "Harmless inspection, search, text-processing, and local diagnostic utilities.",
      "rules": [
        ["pwd", "allow"],
        ["pwd *", "allow"],
        ["ls", "allow"],
        ["ls *", "allow"],
        ["tree", "allow"],
        ["tree *", "allow"],
        ["which *", "allow"],
        ["type *", "allow"],
        ["command -v *", "allow"],
        ["file *", "allow"],
        ["stat *", "allow"],
        ["du *", "allow"],
        ["df *", "allow"],
        ["cat *", "allow"],
        ["head *", "allow"],
        ["tail *", "allow"],
        ["wc *", "allow"],
        ["nl *", "allow"],
        ["find *", "allow"],
        ["fd *", "allow"],
        ["grep *", "allow"],
        ["egrep *", "allow"],
        ["fgrep *", "allow"],
        ["rg *", "allow"],
        ["sed *", "allow"],
        ["jq *", "allow"],
        ["cut *", "allow"],
        ["tr *", "allow"],
        ["sort *", "allow"],
        ["uniq *", "allow"],
        ["paste *", "allow"],
        ["column *", "allow"],
        ["comm *", "allow"],
        ["diff *", "allow"],
        ["cmp *", "allow"],
        ["echo", "allow"],
        ["echo *", "allow"],
        ["printf *", "allow"],
        ["true", "allow"],
        ["false", "allow"],
        ["test *", "allow"],
        ["[ *", "allow"],
        ["date", "allow"],
        ["date *", "allow"],
        ["uname", "allow"],
        ["uname *", "allow"],
        ["whoami", "allow"],
        ["id", "allow"],
        ["basename *", "allow"],
        ["dirname *", "allow"],
        ["realpath *", "allow"],
        ["readlink *", "allow"],
        ["shasum *", "allow"],
        ["sha256sum *", "allow"],
        ["md5 *", "allow"],
        ["md5sum *", "allow"],
        ["base64 *", "allow"],
        ["xxd *", "allow"],
        ["hexdump *", "allow"],
        ["lsof *", "allow"],
        ["ps", "allow"],
        ["ps *", "allow"],
        ["pgrep *", "allow"]
      ]
    },
    "shell-read-guard": {
      "description": "Deny file-mutating or command-executing flags on find, fd, sed, and sort for read-only roles.",
      "rules": [
        ["find -exec*", "deny"],
        ["find * -exec*", "deny"],
        ["find -execdir*", "deny"],
        ["find * -execdir*", "deny"],
        ["find -ok*", "deny"],
        ["find * -ok*", "deny"],
        ["find -delete*", "deny"],
        ["find * -delete*", "deny"],
        ["find -fprint*", "deny"],
        ["find * -fprint*", "deny"],
        ["find -fls*", "deny"],
        ["find * -fls*", "deny"],
        ["find -fprintf*", "deny"],
        ["find * -fprintf*", "deny"],
        ["fd -x*", "deny"],
        ["fd * -x*", "deny"],
        ["fd -X*", "deny"],
        ["fd * -X*", "deny"],
        ["fd --exec*", "deny"],
        ["fd * --exec*", "deny"],
        ["sed -i*", "deny"],
        ["sed * -i*", "deny"],
        ["sed --in-place*", "deny"],
        ["sed * --in-place*", "deny"],
        ["sort -o*", "deny"],
        ["sort * -o*", "deny"],
        ["sort --output*", "deny"],
        ["sort * --output*", "deny"]
      ]
    },
    "shell-build-utils": {
      "description": "Text-processing, archive, network, and command utilities reserved for coding and test roles.",
      "rules": [
        ["awk *", "allow"],
        ["perl *", "allow"],
        ["yq *", "allow"],
        ["patch *", "allow"],
        ["xargs *", "allow"],
        ["tee *", "allow"],
        ["sleep *", "allow"],
        ["timeout *", "allow"],
        ["gtimeout *", "allow"],
        ["time *", "allow"],
        ["tar *", "allow"],
        ["unzip *", "allow"],
        ["zip *", "allow"],
        ["gzip *", "allow"],
        ["gunzip *", "allow"],
        ["curl *", "allow"]
      ]
    },
    "secrets-guard": {
      "description": "Deny reading .env secret files or dumping environment variables while keeping .env.example/.sample/.template/.test and git status/diff readable.",
      "rules": [
        ["env", "deny"],
        ["env *", "deny"],
        ["printenv*", "deny"],
        ["set", "deny"],
        ["export -p*", "deny"],
        ["declare -p*", "deny"],
        ["/usr/bin/env*", "deny"],
        ["/usr/bin/printenv*", "deny"],
        ["*.env*", "deny"],
        ["cat .env.example", "allow"],
        ["cat .env.sample", "allow"],
        ["cat .env.template", "allow"],
        ["cat .env.test", "allow"]
      ]
    },
    "secrets-copy": {
      "description": "Allow coding and test roles to copy non-secret environment templates.",
      "rules": [
        ["cp .env.example *", "allow"],
        ["cp .env.sample *", "allow"],
        ["cp .env.template *", "allow"],
        ["cp .env.test *", "allow"]
      ]
    },
    "git-read": {
      "description": "Working-tree inspection; diff --output (writes a file) is denied.",
      "rules": [
        ["git status*", "allow"],
        ["git diff*", "allow"],
        ["git diff *--output*", "deny"],
        ["git log*", "allow"],
        ["git show*", "allow"],
        ["git log *--output*", "deny"],
        ["git show *--output*", "deny"],
        ["git ls-files*", "allow"],
        ["git grep*", "allow"],
        ["git shortlog*", "allow"],
        ["git describe*", "allow"],
        ["git reflog show*", "allow"],
        ["git stash list*", "allow"],
        ["git stash show*", "allow"],
        ["git worktree list*", "allow"],
        ["git tag -l*", "allow"],
        ["git tag --list*", "allow"],
        ["git remote -v*", "allow"],
        ["git config --get*", "allow"],
        ["git config --list*", "allow"],
        ["git check-ignore*", "allow"],
        ["git check-attr*", "allow"],
        ["git --no-pager status*", "allow"],
        ["git --no-pager diff*", "allow"],
        ["git --no-pager diff *--output*", "deny"],
        ["git --no-pager log*", "allow"],
        ["git --no-pager log *--output*", "deny"],
        ["git --no-pager show*", "allow"],
        ["git --no-pager show *--output*", "deny"],
        ["git --no-pager blame*", "allow"],
        ["git --no-pager branch*", "allow"],
        ["git --no-pager grep*", "allow"],
        ["git --no-pager ls-files*", "allow"],
        ["git -P status*", "allow"],
        ["git -P diff*", "allow"],
        ["git -P diff *--output*", "deny"],
        ["git -P log*", "allow"],
        ["git -P log *--output*", "deny"],
        ["git -P show*", "allow"],
        ["git -P show *--output*", "deny"],
        ["git -C * status*", "allow"],
        ["git -C * diff*", "allow"],
        ["git -C * diff *--output*", "deny"],
        ["git -C * log*", "allow"],
        ["git -C * log *--output*", "deny"],
        ["git -C * show*", "allow"],
        ["git -C * show *--output*", "deny"],
        ["git -C * rev-parse*", "allow"],
        ["git -C * branch*", "allow"]
      ]
    },
    "git-blame": {
      "description": "Line history.",
      "rules": [
        ["git blame*", "allow"]
      ]
    },
    "git-rev-parse": {
      "description": "Resolve refs and repository paths.",
      "rules": [
        ["git rev-parse*", "allow"]
      ]
    },
    "git-merge-base": {
      "description": "Common ancestor lookup.",
      "rules": [
        ["git merge-base*", "allow"]
      ]
    },
    "git-branch-name": {
      "description": "Inspect local and remote branch names.",
      "rules": [
        ["git branch --show-current*", "allow"],
        ["git branch -l*", "allow"],
        ["git branch --list*", "allow"],
        ["git branch -a*", "allow"],
        ["git branch --all*", "allow"],
        ["git branch -r*", "allow"],
        ["git branch --remotes*", "allow"],
        ["git branch -v*", "allow"],
        ["git branch -vv*", "allow"],
        ["git branch --contains*", "allow"],
        ["git branch --merged*", "allow"],
        ["git branch --no-merged*", "allow"]
      ]
    },
    "git-sync": {
      "description": "fetch/pull/merge/rebase/cherry-pick without remote-helper injection or interactive/exec rebase.",
      "rules": [
        ["git fetch*", "allow"],
        ["git fetch *--upload-pack*", "deny"],
        ["git fetch *ext::*", "deny"],
        ["git pull*", "allow"],
        ["git pull *--upload-pack*", "deny"],
        ["git pull *ext::*", "deny"],
        ["git merge*", "allow"],
        ["git rebase*", "allow"],
        ["git rebase *-i*", "deny"],
        ["git rebase *--interactive*", "deny"],
        ["git rebase *-x*", "deny"],
        ["git rebase *--exec*", "deny"],
        ["git cherry-pick*", "allow"]
      ]
    },
    "git-resolve-checkout": {
      "description": "Pick a side of a conflict with checkout.",
      "rules": [
        ["git checkout --ours *", "allow"],
        ["git checkout --theirs *", "allow"]
      ]
    },
    "git-unstage": {
      "description": "Unstage files.",
      "rules": [
        ["git restore --staged *", "allow"]
      ]
    },
    "git-resolve-restore": {
      "description": "Pick a side of a conflict with restore.",
      "rules": [
        ["git restore --ours *", "allow"],
        ["git restore --theirs *", "allow"],
        ["git restore --merge *", "allow"]
      ]
    },
    "git-conflict": {
      "description": "Resolve conflicts by choosing a side or restoring a merge state.",
      "rules": [
        ["git checkout --ours *", "allow"],
        ["git checkout --theirs *", "allow"],
        ["git restore --ours *", "allow"],
        ["git restore --theirs *", "allow"],
        ["git restore --merge *", "allow"]
      ]
    },
    "git-stage": {
      "description": "Stage explicit paths only; bulk staging is denied.",
      "rules": [
        ["git add *", "allow"],
        ["git add .", "deny"],
        ["git add ./", "deny"],
        ["git add -A*", "deny"],
        ["git add --all*", "deny"],
        ["git add -u*", "deny"],
        ["git add --update*", "deny"],
        ["git mv *", "allow"],
        ["git rm *", "allow"],
        ["git rm -r .", "deny"],
        ["git rm -rf .", "deny"],
        ["git rm -r ./", "deny"],
        ["git rm -rf ./", "deny"],
        ["git rm -r ..*", "deny"],
        ["git rm -rf ..*", "deny"],
        ["git rm -r /*", "deny"],
        ["git rm -rf /*", "deny"]
      ]
    },
    "publish-guard": {
      "description": "Never publish packages.",
      "rules": [
        ["npm publish*", "deny"],
        ["pnpm publish*", "deny"],
        ["yarn publish*", "deny"],
        ["bun publish*", "deny"],
        ["cargo publish*", "deny"],
        ["twine upload*", "deny"]
      ]
    },
    "rm-guard": {
      "description": "Deny catastrophic root, home, parent, dot, or .git deletions.",
      "rules": [
        ["rm -rf", "deny"],
        ["rm -fr", "deny"],
        ["rm -r", "deny"],
        ["rm -f", "deny"],
        ["rm -rf /*", "deny"],
        ["rm -fr /*", "deny"],
        ["rm -r /*", "deny"],
        ["rm -rf ~*", "deny"],
        ["rm -fr ~*", "deny"],
        ["rm -r ~*", "deny"],
        ["rm -rf ..*", "deny"],
        ["rm -fr ..*", "deny"],
        ["rm -r ..*", "deny"],
        ["rm -rf .", "deny"],
        ["rm -fr .", "deny"],
        ["rm -r .", "deny"],
        ["rm -rf ./", "deny"],
        ["rm -fr ./", "deny"],
        ["rm -r ./", "deny"],
        ["rm -rf .*", "deny"],
        ["rm -fr .*", "deny"],
        ["rm -r .*", "deny"],
        ["rm * .git*", "deny"]
      ]
    },
    "ops-rm-guard": {
      "description": "Deny recursive or forced rm operations for ops.",
      "rules": [
        ["rm -rf *", "deny"],
        ["rm -fr *", "deny"],
        ["rm -r*", "deny"],
        ["rm -f*", "deny"]
      ]
    },
    "ops-trusted-shell": {
      "description": "Broad semantic access: catch-all allow, with secret, env-dump, destructive, lateral-movement, host-DoS, and privilege gates layered after it.",
      "rules": [
        ["*", "allow"],
        ["env", "deny"],
        ["env *", "deny"],
        ["printenv*", "deny"],
        ["*.env*", "deny"],
        ["* .env *", "deny"],
        ["cat .env.example", "allow"],
        ["cat .env.sample", "allow"],
        ["cat .env.template", "allow"],
        ["cat .env.test", "allow"],
        ["cp .env.example *", "allow"],
        ["cp .env.sample *", "allow"],
        ["cp .env.template *", "allow"],
        ["cp .env.test *", "allow"],
        ["sudo *", "ask"],
        ["psql *", "ask"],
        ["mysql *", "ask"],
        ["mongosh *", "ask"],
        ["redis-cli *", "ask"],
        ["rm *", "ask"],
        ["* install*", "ask"],
        ["* deploy*", "ask"],
        ["* apply*", "ask"],
        ["* submit*", "ask"],
        ["* push*", "ask"],
        ["* release create*", "ask"],
        ["* workflow run*", "ask"],
        ["* upgrade*", "ask"],
        ["* rollback*", "ask"],
        ["* patch*", "ask"],
        ["* scale*", "ask"],
        ["* rollout*", "ask"],
        ["vercel *", "ask"],
        ["ssh *", "ask"],
        ["scp *", "ask"],
        ["sftp *", "ask"],
        ["rsync *", "ask"],
        ["telnet *", "ask"],
        ["mosh *", "ask"],
        ["socat *", "ask"],
        ["nmap *", "ask"],
        ["* rm *", "deny"],
        ["* delete*", "deny"],
        ["*--delete*", "deny"],
        ["* destroy*", "deny"],
        ["* prune*", "deny"],
        ["* uninstall*", "deny"],
        ["* down -v*", "deny"],
        ["* terminate*", "deny"],
        ["terraform import*", "deny"],
        ["terraform * import*", "deny"],
        ["kubectl edit*", "deny"],
        ["kubectl * edit*", "deny"],
        ["set", "deny"],
        ["export -p*", "deny"],
        ["declare -p*", "deny"],
        ["/usr/bin/env*", "deny"],
        ["/usr/bin/printenv*", "deny"],
        ["shutdown*", "deny"],
        ["sudo shutdown*", "deny"],
        ["reboot*", "deny"],
        ["poweroff*", "deny"],
        ["halt*", "deny"],
        ["init 0*", "deny"],
        ["init 6*", "deny"],
        ["mkfs*", "deny"],
        ["systemctl reboot*", "deny"],
        ["systemctl poweroff*", "deny"],
        ["systemctl halt*", "deny"],
        ["systemctl suspend*", "deny"],
        ["systemctl hibernate*", "deny"]
      ]
    },
    "security-scanners": {
      "description": "Dependency and static security scanners.",
      "rules": [
        ["npm audit*", "allow"],
        ["pnpm audit*", "allow"],
        ["yarn audit*", "allow"],
        ["bun audit*", "allow"],
        ["pip-audit*", "allow"],
        ["cargo audit*", "allow"],
        ["govulncheck*", "allow"],
        ["gosec*", "allow"],
        ["semgrep*", "allow"],
        ["trivy*", "allow"],
        ["bandit*", "allow"],
        ["osv-scanner*", "allow"],
        ["hadolint*", "allow"],
        ["shellcheck*", "allow"]
      ]
    },
    "post-session-stage": {
      "description": "Stage explicit paths only; bulk, patch, and interactive staging are denied.",
      "rules": [
        ["git add *", "allow"],
        ["git add -A*", "deny"],
        ["git add --all*", "deny"],
        ["git add -u*", "deny"],
        ["git add --update*", "deny"],
        ["git add -p*", "deny"],
        ["git add --patch*", "deny"],
        ["git add -i*", "deny"],
        ["git add --interactive*", "deny"],
        ["git add .", "deny"],
        ["git add ./", "deny"],
        ["git add -- .", "deny"],
        ["git add */", "deny"],
        ["git add *.", "deny"],
        ["git rm --cached *", "allow"]
      ]
    },
    "post-session-commit": {
      "description": "Commit with a quoted message; amend/all/no-verify are denied; push asks.",
      "rules": [
        ["git commit -m \"*\"", "allow"],
        ["git commit -a*", "deny"],
        ["git commit --all*", "deny"],
        ["git commit * --amend*", "deny"],
        ["git commit * --no-verify*", "deny"],
        ["git commit * --all*", "deny"],
        ["git push*", "ask"]
      ]
    }
  },
  "roles": {
    "explorer": ["deny-all", "cd", "shell-read", "shell-read-guard", "git-read", "git-blame", "git-branch-name", "secrets-guard"],
    "code_reviewer": ["deny-all", "cd", "shell-read", "shell-read-guard", "git-read", "git-blame", "git-branch-name", "test-runners-read", "secrets-guard"],
    "critic": ["deny-all", "cd", "shell-read", "shell-read-guard", "git-read", "git-blame", "git-branch-name", "test-runners-read", "secrets-guard"],
