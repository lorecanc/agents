{
  "version": 1,
  "description": "Single source of truth for pipeline agents' permission.bash blocks. Each role expands to the concatenation of its profiles, in order (OpenCode: last matching rule wins). Apply with: node manage-agents/manage-agents.mjs pipeline sync-bash",
  "profiles": {
    "base-deny": {
      "description": "Deny everything not listed; allow changing directory.",
      "rules": [
        ["*", "deny"],
        ["cd *", "allow"]
      ]
    },
    "build-tools": {
      "description": "Language runtimes, package managers, build and test runners.",
      "rules": [
        ["node *", "allow"],
        ["npm *", "allow"],
        ["npx *", "allow"],
        ["pnpm *", "allow"],
        ["yarn *", "allow"],
        ["bun *", "allow"],
        ["deno *", "allow"],
        ["python *", "allow"],
        ["python3 *", "allow"],
        ["pytest*", "allow"],
        ["uv *", "allow"],
        ["poetry *", "allow"],
        ["pip *", "allow"],
        ["pip3 *", "allow"],
        ["go *", "allow"],
        ["cargo *", "allow"],
        ["rustc *", "allow"],
        ["make*", "allow"],
        ["cmake *", "allow"],
        ["gradle *", "allow"],
        ["./gradlew*", "allow"],
        ["mvn *", "allow"],
        ["./mvnw*", "allow"],
        ["dotnet *", "allow"],
        ["bundle *", "allow"],
        ["rake*", "allow"],
        ["rspec*", "allow"],
        ["composer *", "allow"],
        ["php *", "allow"],
        ["swift *", "allow"],
        ["xcodebuild *", "allow"],
        ["xcrun *", "allow"]
      ]
    },
    "fs-basic": {
      "description": "Create directories; single-file rm asks (rm-guard denies recursive/forced forms).",
      "rules": [
        ["mkdir -p *", "allow"],
        ["rm *", "ask"]
      ]
    },
    "fs-move": {
      "description": "Copy and move files.",
      "rules": [
        ["cp *", "allow"],
        ["mv *", "allow"]
      ]
    },
    "git-read": {
      "description": "Working-tree inspection; diff --output (writes a file) is denied.",
      "rules": [
        ["git status*", "allow"],
        ["git diff*", "allow"],
        ["git diff *--output*", "deny"],
        ["git log*", "allow"],
        ["git show*", "allow"]
      ]
    },
    "git-blame": {
      "description": "Line history.",
      "rules": [
        ["git blame*", "allow"]
      ]
    },
    "git-rev-parse": {
      "description": "Resolve refs and repository paths.",
      "rules": [
        ["git rev-parse*", "allow"]
      ]
    },
    "git-merge-base": {
      "description": "Common ancestor lookup.",
      "rules": [
        ["git merge-base*", "allow"]
      ]
    },
    "git-branch-name": {
      "description": "Current branch name only.",
      "rules": [
        ["git branch --show-current*", "allow"]
      ]
    },
    "git-sync": {
      "description": "fetch/pull/merge/rebase/cherry-pick without remote-helper injection or interactive/exec rebase.",
      "rules": [
        ["git fetch*", "allow"],
        ["git fetch *--upload-pack*", "deny"],
        ["git fetch *ext::*", "deny"],
        ["git pull*", "allow"],
        ["git pull *--upload-pack*", "deny"],
        ["git pull *ext::*", "deny"],
        ["git merge*", "allow"],
        ["git rebase*", "allow"],
        ["git rebase *-i*", "deny"],
        ["git rebase *--interactive*", "deny"],
        ["git rebase *-x*", "deny"],
        ["git rebase *--exec*", "deny"],
        ["git cherry-pick*", "allow"]
      ]
    },
    "git-resolve-checkout": {
      "description": "Pick a side of a conflict with checkout.",
      "rules": [
        ["git checkout --ours *", "allow"],
        ["git checkout --theirs *", "allow"]
      ]
    },
    "git-unstage": {
      "description": "Unstage files.",
      "rules": [
        ["git restore --staged *", "allow"]
      ]
    },
    "git-resolve-restore": {
      "description": "Pick a side of a conflict with restore.",
      "rules": [
        ["git restore --ours *", "allow"],
        ["git restore --theirs *", "allow"],
        ["git restore --merge *", "allow"]
      ]
    },
    "git-stage": {
      "description": "Stage explicit paths only; bulk staging is denied.",
      "rules": [
        ["git add *", "allow"],
        ["git add .", "deny"],
        ["git add ./", "deny"],
        ["git add -A*", "deny"],
        ["git add --all*", "deny"],
        ["git add -u*", "deny"],
        ["git add --update*", "deny"]
      ]
    },
    "publish-guard": {
      "description": "Never publish packages.",
      "rules": [
        ["npm publish*", "deny"],
        ["pnpm publish*", "deny"],
        ["yarn publish*", "deny"],
        ["bun publish*", "deny"],
        ["cargo publish*", "deny"],
        ["twine upload*", "deny"]
      ]
    },
    "rm-guard": {
      "description": "Deny recursive or forced rm in every spelling.",
      "rules": [
        ["rm -r*", "deny"],
        ["rm -f*", "deny"],
        ["rm -rf /*", "deny"],
        ["rm -fr /*", "deny"],
        ["rm -rf ~*", "deny"],
        ["rm -fr ~*", "deny"],
        ["rm -rf ..*", "deny"],
        ["rm -fr ..*", "deny"],
        ["rm -rf .", "deny"],
        ["rm -fr .", "deny"],
        ["rm -rf *", "deny"],
        ["rm -fr *", "deny"],
        ["rm * -r*", "deny"],
        ["rm * -f*", "deny"],
        ["rm --recursive*", "deny"],
        ["rm * --recursive*", "deny"]
      ]
    },
    "ops-trusted-shell": {
      "description": "Broad semantic access: catch-all allow, with secret, destructive, and privilege gates layered after it.",
      "rules": [
        ["*", "allow"],
        ["env", "deny"],
        ["env *", "deny"],
        ["printenv*", "deny"],
        ["*.env*", "deny"],
        ["cat .env.example", "allow"],
        ["cat .env.sample", "allow"],
        ["sudo *", "ask"],
        ["psql *", "ask"],
        ["mysql *", "ask"],
        ["mongosh *", "ask"],
        ["redis-cli *", "ask"],
        ["rm *", "ask"],
        ["* install*", "ask"],
        ["* deploy*", "ask"],
        ["* apply*", "ask"],
        ["* submit*", "ask"],
        ["* push*", "ask"],
        ["* release create*", "ask"],
        ["* workflow run*", "ask"],
        ["* upgrade*", "ask"],
        ["* rollback*", "ask"],
        ["* patch*", "ask"],
        ["* scale*", "ask"],
        ["* rollout*", "ask"],
        ["vercel *", "ask"],
        ["* rm *", "deny"],
        ["* delete*", "deny"],
        ["*--delete*", "deny"],
        ["* destroy*", "deny"],
        ["* prune*", "deny"],
        ["* uninstall*", "deny"],
        ["* down -v*", "deny"],
        ["* terminate*", "deny"],
        ["terraform import*", "deny"],
        ["terraform * import*", "deny"],
        ["kubectl edit*", "deny"],
        ["kubectl * edit*", "deny"]
      ]
    },
    "audit-tools": {
      "description": "Dependency and static security scanners.",
      "rules": [
        ["npm audit*", "allow"],
        ["pnpm audit*", "allow"],
        ["yarn audit*", "allow"],
        ["bun audit*", "allow"],
        ["pip-audit*", "allow"],
        ["cargo audit*", "allow"],
        ["govulncheck*", "allow"],
        ["gosec*", "allow"],
        ["semgrep*", "allow"],
        ["trivy*", "allow"],
        ["bandit*", "allow"],
        ["osv-scanner*", "allow"],
        ["hadolint*", "allow"],
        ["shellcheck*", "allow"]
      ]
    },
    "post-session-stage": {
      "description": "Stage explicit paths only; bulk, patch, and interactive staging are denied.",
      "rules": [
        ["git add *", "allow"],
        ["git add -A*", "deny"],
        ["git add --all*", "deny"],
        ["git add -u*", "deny"],
        ["git add --update*", "deny"],
        ["git add -p*", "deny"],
        ["git add --patch*", "deny"],
        ["git add -i*", "deny"],
        ["git add --interactive*", "deny"],
        ["git add .", "deny"],
        ["git add ./", "deny"],
        ["git add -- .", "deny"],
        ["git add */", "deny"],
        ["git add *.", "deny"]
      ]
    },
    "post-session-commit": {
      "description": "Commit with a message; amend/all/no-verify are denied; push asks.",
      "rules": [
        ["git commit -m *", "allow"],
        ["git commit -a*", "deny"],
        ["git commit --all*", "deny"],
        ["git commit * --amend*", "deny"],
        ["git commit * --no-verify*", "deny"],
        ["git commit * --all*", "deny"],
        ["git push*", "ask"]
      ]
    }
  },
  "roles": {
    "explorer": ["base-deny", "git-read", "git-blame", "git-rev-parse", "git-merge-base", "git-branch-name"],
    "code_reviewer": ["base-deny", "git-read", "git-blame", "git-rev-parse", "git-merge-base", "git-branch-name"],
    "critic": ["base-deny", "git-read", "git-blame", "git-rev-parse", "git-merge-base", "git-branch-name"],
    "hitl": ["base-deny", "git-read", "git-blame", "git-rev-parse", "git-merge-base", "git-branch-name"],
    "security_auditor": ["base-deny", "git-read", "git-blame", "git-rev-parse", "git-merge-base", "git-branch-name", "audit-tools"],
    "executor": ["base-deny", "build-tools", "fs-basic", "fs-move", "git-read", "git-rev-parse", "git-merge-base", "git-branch-name", "git-sync", "git-resolve-checkout", "git-unstage", "git-resolve-restore", "git-stage", "publish-guard", "rm-guard"],
    "fast_lane": ["base-deny", "build-tools", "fs-basic", "fs-move", "git-read", "git-rev-parse", "git-merge-base", "git-branch-name", "git-sync", "git-resolve-checkout", "git-unstage", "git-resolve-restore", "git-stage", "publish-guard", "rm-guard"],
    "refactorer": ["base-deny", "build-tools", "fs-basic", "fs-move", "git-read", "git-rev-parse", "git-merge-base", "git-branch-name", "git-sync", "git-resolve-checkout", "git-unstage", "git-resolve-restore", "git-stage", "publish-guard", "rm-guard"],
    "tester": ["base-deny", "build-tools", "fs-basic", "fs-move", "git-read", "git-rev-parse", "git-merge-base", "git-branch-name", "rm-guard"],
    "ops": ["ops-trusted-shell", "publish-guard", "rm-guard"],
    "post_session": ["base-deny", "git-read", "git-rev-parse", "git-branch-name", "git-unstage", "post-session-stage", "post-session-commit"]
  }
}
