{
  "schemaVersion": 2,
  "distributionVersion": "2.0.0",
  "id": "docs",
  "title": "Documentation category bundle",
  "description": "Portable documentation agents, commands, skills, and document tooling.",
  "output": "export/categories/docs",
  "allowRequirements": true,
  "resources": [
    { "kind": "file", "source": "src/AGENTS.md", "target": "AGENTS.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/agents/docs-orchestrator.md", "target": "agents/docs-orchestrator.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/agents/docs-planner.md", "target": "agents/docs-planner.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/agents/docs-html_writer.md", "target": "agents/docs-html_writer.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/commands/new-doc.md", "target": "commands/new-doc.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/commands/edit-doc.md", "target": "commands/edit-doc.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/commands/convert-doc.md", "target": "commands/convert-doc.md", "policy": "text", "primary": true },
    { "kind": "file", "source": "src/commands/web-audit.md", "target": "commands/web-audit.md", "policy": "text" },
    { "kind": "directory", "source": "src/skills/docx", "target": "skills/docx", "policy": "text" },
    { "kind": "directory", "source": "src/plugins/doc-tools", "target": "plugins/doc-tools", "policy": "text" },
    { "kind": "directory", "source": "src/tools/docx", "target": "tools/docx", "policy": "mixed", "extensions": [".py", ".md", ".js"] },
    { "kind": "file", "source": "src/tools/_safeName.js", "target": "tools/_safeName.js", "policy": "text" },
    { "kind": "file", "source": "src/tools/_tool.ts", "target": "tools/_tool.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_compile_theme.ts", "target": "tools/doc_compile_theme.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_convert.ts", "target": "tools/doc_convert.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_create.ts", "target": "tools/doc_create.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_list.ts", "target": "tools/doc_list.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_modify.ts", "target": "tools/doc_modify.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_restore.ts", "target": "tools/doc_restore.ts", "policy": "text" },
    { "kind": "file", "source": "src/tools/doc_view.ts", "target": "tools/doc_view.ts", "policy": "text" },
    { "kind": "file", "source": "src/requirements.txt", "target": "requirements.txt", "policy": "text" }
  ],
  "generated": [{ "kind": "config", "id": "opencode-local-codebase-memory-v1", "target": "opencode.json" }]
}
