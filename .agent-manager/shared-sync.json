{
  "schemaVersion": 1,
  "components": {
    "agentManager": {
      "version": "1.1.0",
      "description": "Shared Agent Manager CLI/TUI, validators, bridge translators, and bash permission profiles",
      "include": [
        "manage-agents.sh",
        "manage-agents/manage-agents.mjs",
        "manage-agents/package.json",
        "manage-agents/package-lock.json",
        "manage-agents/tsconfig.json",
        "manage-agents/README.md",
        "manage-agents/GUIDA.md",
        "manage-agents/assets/**",
        "manage-agents/src/**",
        ".agent-manager/bash-profiles.json",
        ".agent-manager/translation-config.json"
      ],
      "exclude": [
        "manage-agents/node_modules/**",
        "manage-agents/dist/**"
      ]
    },
    "pipelineCore": {
      "version": "1.1.0",
      "requiresAgentManager": ">=1.1.0 <2.0.0",
      "description": "Shared canonical pipeline agents, commands, guard plugin, and pipeline tools",
      "include": [
        "src/agents/pipeline-*.md",
        "src/commands/pipeline-*.md",
        "src/plugins/pipeline-guard.js",
        "src/plugins/README.md",
        "src/tools/*pipeline*",
        "src/tools/_guards*",
        "src/tools/_paths.js",
        "src/tools/_safeName*",
        "src/docs/mcp-configuration.md"
      ],
      "exclude": []
    }
  },
  "localOverlay": {
    "neverOverwrite": [
      "src/agents/ontology-*.md",
      "src/tools/ontology/**",
      "src/skills/ontology-*/**",
      "src/resources/ontology/**",
      "src/ontology-pipeline.md",
      ".agent-manager/pipeline-profiles.json",
      ".agent-manager/companion-links.json",
      ".agent-manager/categories/**",
      "src/opencode.json",
      "export/categories/**",
      "export/bridges/**"
    ]
  }
}
