{
  "schemaVersion": 1,
  "components": {
    "agentManager": {
      "version": "1.3.0",
      "description": "Shared Agent Manager CLI/TUI, validators, bridge translators, and bash permission profiles",
      "include": [
        "manage-agents.sh",
        "manage-agents/manage-agents.mjs",
        "manage-agents/README.md",
        "manage-agents/GUIDA.md",
        "manage-agents/assets/**",
        "manage-agents/src/**",
        ".agent-manager/bash-profiles.json",
        ".agent-manager/translation-config.json"
      ],
      "exclude": [
        "manage-agents/node_modules/**",
        "manage-agents/dist/**",
        "manage-agents/package.json",
        "manage-agents/package-lock.json",
        "manage-agents/tsconfig.json",
        "manage-agents/bun.lock",
        "manage-agents/bunfig.toml",
        "manage-agents/.npmrc",
        "manage-agents/integration/**"
      ]
    },
    "pipelineCore": {
      "version": "1.3.0",
      "requiresAgentManager": ">=1.3.0 <2.0.0",
      "description": "Shared canonical catalog: every agent and command with the plugins, tools, skills, resources and documents they link, plus the benchmark",
      "include": [
        "src/AGENTS.md",
        "src/requirements.txt",
        "src/agents/*.md",
        "src/agents/pipeline-*.md",
        "src/agents/flow-*.md",
        "src/commands/**",
        "src/plugins/**",
        "src/tools/**",
        "src/skills/**",
        "src/resources/**",
        "src/docs/**",
        "src/office/**",
        "src/bench/**",
        "src/bin/**"
      ],
      "exclude": []
    }
  },
  "localOverlay": {
    "neverOverwrite": [
      "src/agents/ontology-*.md",
      "src/tools/ontology/**",
      "src/skills/ontology-*/**",
      "src/resources/ontology/**",
      "src/ontology-pipeline.md",
      "src/plugins/ontology-*/**",
      "src/commands/ontology-*",
      ".agent-manager/agent-routing.json",
      "src/plugins/agent-router/routing.json",
      ".agent-manager/companion-links.json",
      ".agent-manager/categories/**",
      "src/opencode.json",
      "export/categories/**",
      "export/bridges/**",
      "manage-agents/package.json",
      "manage-agents/package-lock.json",
      "manage-agents/tsconfig.json",
      "manage-agents/bun.lock",
      "manage-agents/bunfig.toml",
      "manage-agents/.npmrc",
      "manage-agents/integration/**"
    ]
  }
}
