# Normalize text files to LF across platforms.
* text=auto eol=lf

# Canonical category sources and common text formats.
agents/categories/** text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
