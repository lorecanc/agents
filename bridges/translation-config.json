{
  "version": 2,
  "target": "claude",
  "pluginName": "decent-pipeline",
  "prefix": "pipeline-",
  "sourceDir": "src",
  "inference": true,
  "defaultTier": "execution",
  "tiers": {
    "planning": {
      "description": "Agents that reason, plan and review",
      "claude": {
        "model": "opus"
      },
      "codex": {
        "model": "gpt-6.1-terra",
        "reasoningEffort": "medium"
      }
    },
    "execution": {
      "description": "Agents that execute tasks, cheaper and faster",
      "claude": {
        "model": "sonnet"
      },
      "codex": {
        "model": "gpt-6.1-terra",
        "reasoningEffort": "medium"
      }
    },
    "light": {
      "description": "Agents that do lightweight work (claude haiku; codex parity with execution)",
      "claude": {
        "model": "haiku"
      },
      "codex": {
        "model": "gpt-6.1-terra",
        "reasoningEffort": "medium"
      }
    }
  },
  "roles": {
    "orchestrator": "planning",
    "planner": "planning",
    "reasoner": "planning",
    "critic": "execution",
    "code_reviewer": "execution",
    "executor": "light",
    "explorer": "light",
    "refactorer": "execution",
    "tester": "execution",
    "fast_lane": "execution"
  },
  "claude": {
    "overrides": {},
    "modelMap": {},
    "emitMarketplace": true,
    "emitCommands": true,
    "emitSkills": true,
    "autoValidate": true,
    "autoRegister": false
  },
  "codex": {
    "overrides": {
      "orchestrator": {
        "model": "inherit"
      },
      "planner": {
        "model": "inherit"
      },
      "reasoner": {
        "model": "inherit"
      },
      "build": {
        "model": "inherit"
      },
      "plan": {
        "model": "inherit"
      },
      "explorer": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      },
      "researcher": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      },
      "docs_grounding": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      },
      "explore": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      },
      "research": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      }
    },
    "modelMap": {},
    "emitSkills": true,
    "emitReadme": true
  }
}
