{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp"
    },
    "XcodeBuildMCP": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "${TWENTYFIRST_API_KEY}"
      }
    },
    "cupertino": {
      "command": "cupertino",
      "args": [
        "serve"
      ]
    },
    "axiom": {
      "command": "npx",
      "args": [
        "-y",
        "axiom-mcp"
      ]
    },
    "cwe-search": {
      "command": "npx",
      "args": [
        "-y",
        "cwe-search-mcp@latest"
      ]
    },
    "bigquery": {
      "type": "http",
      "url": "https://bigquery.googleapis.com/mcp"
    },
    "cloud-run": {
      "type": "http",
      "url": "https://run.googleapis.com/mcp"
    },
    "cloud-logging": {
      "type": "http",
      "url": "https://logging.googleapis.com/mcp"
    },
    "cloud-monitoring": {
      "type": "http",
      "url": "https://monitoring.googleapis.com/mcp"
    },
    "cloud-sql": {
      "type": "http",
      "url": "https://sqladmin.googleapis.com/mcp"
    },
    "cloud-storage": {
      "type": "http",
      "url": "https://storage.googleapis.com/storage/mcp"
    },
    "cloud-cli": {
      "type": "http",
      "url": "https://cloudcli.googleapis.com/mcp"
    }
  }
}
