{
  "name": "manage-agents",
  "version": "1.0.0",
  "description": "Standalone terminal agent manager for the agents monorepo",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "manage-agents": "./manage-agents.mjs"
  },
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.3.0"
  },
  "type": "module",
  "scripts": {
    "start": "node manage-agents.mjs",
    "build": "node src/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test \"src/utils/*.test.ts\" \"test/**/*.test.ts\" \"runtime/**/*.test.mjs\" \"scripts/*.test.ts\" \"../src/tools/*.test.mjs\" \"../src/bench/*.test.mjs\" \"ext/**/*.test.ts\"",
    "validate": "npm run typecheck && npm test && npm run build && node manage-agents.mjs --no-auto-commit category build --all && node manage-agents.mjs category check --all && node manage-agents.mjs bridge check"
  },
  "dependencies": {
    "@opentui/core": "0.5.7",
    "@opentui/react": "0.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.33.0",
    "semver": "^7.8.6",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
