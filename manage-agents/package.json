{
  "name": "manage-agents",
  "version": "1.0.0",
  "description": "Standalone terminal agent manager for the agents monorepo",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "manage-agents": "./manage-agents.mjs"
  },
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.3.0"
  },
  "type": "module",
  "scripts": {
    "start": "node manage-agents.mjs",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --outfile=dist/index.js --external:@opentui/core --external:yaml",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test \"src/utils/*.test.ts\" \"../src/tools/_python.test.mjs\" \"../src/tools/_safeName.test.mjs\" \"../src/tools/_guards.test.mjs\" \"../src/tools/_pipeline_core.test.mjs\" \"../src/tools/_pipeline_run.test.mjs\" \"../src/tools/_pipeline_guard.test.mjs\" \"../src/tools/_pipeline_tools.test.mjs\" \"../src/tools/_pipeline_env.test.mjs\" \"../src/tools/_pipeline_serve.test.mjs\" \"../src/tools/_pipeline_services.test.mjs\" \"../src/tools/_pipeline_worktree.test.mjs\" \"../src/bench/bench.test.mjs\"",
    "validate": "npm run typecheck && npm test && npm run build && node manage-agents.mjs category check --all"
  },
  "dependencies": {
    "@opentui/core": "0.5.7",
    "@opentui/react": "0.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.33.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "tsx": "^4.23.1"
  }
}
