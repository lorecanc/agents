{
  "name": "manage-agents",
  "version": "1.0.0",
  "description": "Standalone terminal agent manager for the agents monorepo",
  "main": "dist/index.js",
  "bin": {
    "manage-agents": "./manage-agents.mjs"
  },
  "engines": {
    "node": ">=26.1.0",
    "bun": ">=1.2.0"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --outfile=dist/index.js --external:@opentui/core --external:yaml",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test \"src/utils/*.test.ts\" \"../agents/general/tools/_python.test.mjs\""
  },
  "dependencies": {
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.33.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "tsx": "^4.23.1"
  }
}
