{
  "contract": "1.0",
  "name": "flow",
  "version": "1.0.0",
  "description": "Claude Code style build agent with plan mode, read-only subagents (explore, review, research, eye, ops), flow commands, skills and guard plugins",
  "requires": {
    "code-review": "^1.0.0",
    "common": "^1.0.0",
    "dev-tools": "^1.0.0",
    "integrations": "^1.0.0",
    "toolkit": "^1.0.0"
  },
  "archetype": {
    "callers": [
      "flow-build",
      "flow-plan"
    ],
    "reference": "flow-build"
  },
  "routingDefaults": {
    "mistral": {
      "flow-explore": "mistral/deepseek-v4-1-flash-1017#high",
      "flow-eye": "mistral/zai-glm-5-3-flash#high",
      "flow-ops": "mistral/deepseek-v4-1-flash-1017#high",
      "flow-research": "mistral/deepseek-v4-1-flash-1017#high",
      "flow-review": "mistral/deepseek-v4-1-flash-1017#high"
    },
    "opencode": {
      "flow-explore": "opencode/deepseek-v4.1-flash-free#high",
      "flow-eye": "opencode/deepseek-v4.1-flash-free#high",
      "flow-ops": "opencode/deepseek-v4.1-flash-free#high",
      "flow-research": "opencode/deepseek-v4.1-flash-free#high",
      "flow-review": "opencode/deepseek-v4.1-flash-free#high"
    },
    "opencode-go": {
      "flow-explore": "opencode-go/deepseek-v4.1-flash#high",
      "flow-eye": "opencode-go/deepseek-v4.1-flash#high",
      "flow-ops": "opencode-go/deepseek-v4.1-flash#high",
      "flow-research": "opencode-go/deepseek-v4.1-flash#high",
      "flow-review": "opencode-go/deepseek-v4.1-flash#high"
    }
  }
}
