{
  "version": 1,
  "description": "Single source of truth for the shell rules of the pipeline agents (packs/pipeline/agents). Each role expands to the concatenation of its profiles, in order (OpenCode: last matching rule wins). Apply with: npm run sync-bash",
  "profiles": {
    "allow-all": {
      "description": "Workspace-agnostic shell access; focused safety profiles below provide the boundaries.",
      "rules": [["*", "allow"]]
    },
    "deny-all": {
      "description": "Deny everything not listed.",
      "rules": [["*", "deny"]]
    },
    "cd": {
      "description": "Allow changing directory.",
      "rules": [["cd *", "allow"]]
    },
    "privilege-and-host-guard": {
      "description": "Deny privilege elevation and host-shutdown or filesystem-formatting commands.",
      "rules": [
        ["sudo", "deny"], ["sudo *", "deny"],
        ["doas", "deny"], ["doas *", "deny"],
        ["su", "deny"], ["su *", "deny"],
        ["pkexec", "deny"], ["pkexec *", "deny"],
        ["shutdown*", "deny"], ["reboot*", "deny"], ["poweroff*", "deny"], ["halt*", "deny"],
        ["init 0*", "deny"], ["init 6*", "deny"], ["mkfs*", "deny"],
        ["systemctl reboot*", "deny"], ["systemctl poweroff*", "deny"],
        ["systemctl halt*", "deny"], ["systemctl suspend*", "deny"], ["systemctl hibernate*", "deny"]
      ]
    },
    "secrets-guard": {
      "description": "Deny environment dumps and real .env files while allowing safe environment templates.",
      "rules": [
        ["env", "deny"], ["/usr/bin/env", "deny"],
        ["env -*", "deny"], ["/usr/bin/env -*", "deny"],
        ["env *=*", "deny"], ["/usr/bin/env *=*", "deny"],
        ["printenv*", "deny"], ["/usr/bin/printenv*", "deny"],
        ["set", "deny"], ["export -p*", "deny"], ["declare -p*", "deny"],
        ["* .env", "deny"], ["* .env *", "deny"], ["*/.env", "deny"], ["*/.env *", "deny"],
        ["* .env.*", "deny"], ["*/.env.*", "deny"],
        ["cat .env.example", "allow"], ["cat .env.sample", "allow"],
        ["cat .env.template", "allow"], ["cat .env.test", "allow"],
        ["head .env.example", "allow"], ["head .env.sample", "allow"],
        ["head .env.template", "allow"], ["head .env.test", "allow"]
      ]
    },
    "secrets-copy": {
      "description": "Allow copying non-secret environment templates for roles that perform local setup.",
      "rules": [
        ["cp .env.example *", "allow"], ["cp .env.sample *", "allow"],
        ["cp .env.template *", "allow"], ["cp .env.test *", "allow"]
      ]
    },
    "secrets-copy-guard": {
      "description": "Deny copying environment templates onto real .env files.",
      "rules": [["cp * .env", "deny"], ["cp * */.env", "deny"]]
    },
    "rm-guard": {
      "description": "Deny catastrophic root, home, parent, dot, or .git deletions.",
      "rules": [
        ["rm -rf", "deny"], ["rm -fr", "deny"], ["rm -r", "deny"], ["rm -f", "deny"],
        ["rm -rf /*", "deny"], ["rm -fr /*", "deny"], ["rm -r /*", "deny"], ["rm /*", "deny"], ["rm /", "deny"],
        ["rm -rf ~*", "deny"], ["rm -fr ~*", "deny"], ["rm -r ~*", "deny"], ["rm ~*", "deny"],
        ["rm -rf ..*", "deny"], ["rm -fr ..*", "deny"], ["rm -r ..*", "deny"], ["rm ..*", "deny"],
        ["rm -rf .", "deny"], ["rm -fr .", "deny"], ["rm -r .", "deny"], ["rm .", "deny"],
        ["rm -rf ./", "deny"], ["rm -fr ./", "deny"], ["rm -r ./", "deny"], ["rm ./", "deny"],
        ["rm -rf .*", "deny"], ["rm -fr .*", "deny"], ["rm -r .*", "deny"], ["rm .*", "deny"],
        ["rm .git*", "deny"], ["rm * .git*", "deny"]
      ]
    },
    "ops-rm-guard": {
      "description": "Deny recursive or forced rm operations for ops.",
      "rules": [["rm -rf *", "deny"], ["rm -fr *", "deny"], ["rm -r*", "deny"], ["rm -f*", "deny"]]
    },
    "remote-and-cloud-ask": {
      "description": "Require confirmation for remote, cloud, infrastructure, and deployment operations.",
      "rules": [
        ["docker push*", "ask"], ["kubectl *", "ask"], ["helm *", "ask"], ["terraform *", "ask"],
        ["gcloud *", "ask"], ["aws *", "ask"], ["az *", "ask"], ["flyctl *", "ask"],
        ["vercel *", "ask"], ["wrangler deploy*", "ask"],
        ["ssh *", "ask"], ["scp *", "ask"], ["sftp *", "ask"], ["rsync *", "ask"],
        ["* deploy*", "ask"], ["* apply*", "ask"], ["* destroy*", "ask"], ["* publish*", "ask"]
      ]
    },
    "publish-guard": {
      "description": "Never publish or upload packages.",
      "rules": [
        ["npm publish*", "deny"], ["pnpm publish*", "deny"], ["yarn publish*", "deny"],
        ["bun publish*", "deny"], ["cargo publish*", "deny"], ["twine upload*", "deny"],
        ["gem push*", "deny"], ["dotnet nuget push*", "deny"]
      ]
    },
    "pipeline-git-coding-guard": {
      "description": "Deny history, workspace, remote-write, and mass-staging operations for coding roles.",
      "rules": [
        ["git push*", "deny"], ["git commit*", "deny"], ["git reset*", "deny"], ["git clean*", "deny"],
        ["git switch*", "deny"], ["git checkout -b*", "deny"], ["git checkout -B*", "deny"], ["git checkout --orphan*", "deny"],
        ["git stash", "deny"], ["git stash push*", "deny"], ["git stash save*", "deny"],
        ["git stash pop*", "deny"], ["git stash apply*", "deny"], ["git stash drop*", "deny"],
        ["git stash clear*", "deny"], ["git stash branch*", "deny"],
        ["git worktree add*", "deny"], ["git worktree remove*", "deny"], ["git worktree move*", "deny"], ["git worktree prune*", "deny"],
        ["git branch -d*", "deny"], ["git branch -D*", "deny"], ["git branch -m*", "deny"], ["git branch -M*", "deny"],
        ["git branch --delete*", "deny"], ["git branch --move*", "deny"],
        ["git tag -a*", "deny"], ["git tag -d*", "deny"], ["git tag -f*", "deny"], ["git tag -s*", "deny"],
        ["git rebase -i*", "deny"], ["git rebase --interactive*", "deny"], ["git rebase -x*", "deny"], ["git rebase --exec*", "deny"],
        ["git fetch *--upload-pack*", "deny"], ["git pull *--upload-pack*", "deny"], ["*ext::*", "deny"],
        ["git add .", "deny"], ["git add ./", "deny"], ["git add -- .", "deny"],
        ["git add -A*", "deny"], ["git add --all*", "deny"], ["git add -u*", "deny"], ["git add --update*", "deny"],
        ["git add -p*", "deny"], ["git add --patch*", "deny"], ["git add -i*", "deny"], ["git add --interactive*", "deny"]
      ]
    },
    "pipeline-git-tester-guard": {
      "description": "Deny every git mutation for the tester role.",
      "rules": [
        ["git add*", "deny"], ["git rm*", "deny"], ["git mv*", "deny"], ["git pull*", "deny"],
        ["git merge*", "deny"], ["git rebase*", "deny"], ["git cherry-pick*", "deny"],
        ["git checkout*", "deny"], ["git restore*", "deny"]
      ]
    },
    "readonly-mutation-guard": {
      "description": "Deny filesystem, git-state, and package mutations for read-only roles.",
      "rules": [
        ["rm *", "deny"], ["rmdir *", "deny"], ["mkdir *", "deny"], ["touch *", "deny"],
        ["mv *", "deny"], ["cp *", "deny"], ["ln *", "deny"], ["chmod *", "deny"],
        ["chown *", "deny"], ["chgrp *", "deny"], ["tee *", "deny"], ["truncate *", "deny"],
        ["dd *", "deny"], ["patch *", "deny"], ["install *", "deny"],
        ["sed -i*", "deny"], ["sed * -i*", "deny"], ["sed *--in-place*", "deny"],
        ["perl -i*", "deny"], ["perl -pi*", "deny"], ["perl *-i*", "deny"],
        ["find *-exec*", "deny"], ["find *-execdir*", "deny"], ["find *-delete*", "deny"], ["find *-ok*", "deny"],
        ["fd *-x*", "deny"], ["fd *-X*", "deny"], ["fd *--exec*", "deny"],
        ["python -c*", "deny"], ["python *-c *", "deny"],
        ["python3 -c*", "deny"], ["python3 *-c *", "deny"],
        ["node -e*", "deny"], ["node *-e *", "deny"], ["node --eval*", "deny"], ["node *--eval*", "deny"],
        ["node -p*", "deny"], ["node *-p *", "deny"], ["node --print*", "deny"], ["node *--print*", "deny"],
        ["bun -e*", "deny"], ["bun *-e *", "deny"], ["bun --eval*", "deny"],
        ["deno eval*", "deny"], ["tsx -e*", "deny"],
        ["ruby -e*", "deny"], ["ruby *-e *", "deny"],
        ["perl -e*", "deny"], ["perl *-e *", "deny"], ["perl -E*", "deny"],
        ["php -r*", "deny"], ["php *-r *", "deny"], ["lua -e*", "deny"], ["osascript -e*", "deny"],
        ["sh -c*", "deny"], ["bash -c*", "deny"], ["zsh -c*", "deny"],
        ["/bin/sh -c*", "deny"], ["/bin/bash -c*", "deny"], ["/bin/zsh -c*", "deny"],
        ["sort *-o *", "deny"], ["sort *--output*", "deny"],
        ["git push*", "deny"], ["git commit*", "deny"], ["git add*", "deny"], ["git rm*", "deny"],
        ["git mv*", "deny"], ["git reset*", "deny"], ["git clean*", "deny"], ["git checkout*", "deny"],
        ["git switch*", "deny"], ["git restore*", "deny"], ["git merge*", "deny"], ["git rebase*", "deny"],
        ["git cherry-pick*", "deny"], ["git pull*", "deny"], ["git fetch*", "deny"],
        ["git tag -a*", "deny"], ["git tag -d*", "deny"], ["git tag -f*", "deny"], ["git tag -s*", "deny"],
        ["git branch -d*", "deny"], ["git branch -D*", "deny"], ["git branch -m*", "deny"], ["git branch -M*", "deny"],
        ["git branch --delete*", "deny"], ["git branch --move*", "deny"],
        ["git stash", "deny"], ["git stash push*", "deny"], ["git stash save*", "deny"],
        ["git stash pop*", "deny"], ["git stash apply*", "deny"], ["git stash drop*", "deny"],
        ["git stash clear*", "deny"], ["git stash branch*", "deny"],
        ["git worktree add*", "deny"], ["git worktree remove*", "deny"], ["git worktree move*", "deny"],
        ["git worktree prune*", "deny"], ["git worktree lock*", "deny"], ["git worktree unlock*", "deny"],
        ["git diff *--output*", "deny"], ["git log *--output*", "deny"], ["git show *--output*", "deny"],
        ["git -P diff *--output*", "deny"], ["git -P log *--output*", "deny"], ["git -P show *--output*", "deny"],
        ["git --no-pager diff *--output*", "deny"], ["git --no-pager log *--output*", "deny"], ["git --no-pager show *--output*", "deny"],
        ["git -C * diff *--output*", "deny"], ["git -C * log *--output*", "deny"], ["git -C * show *--output*", "deny"],
        ["npm install*", "deny"], ["npm i *", "deny"], ["npm ci*", "deny"], ["npm uninstall*", "deny"],
        ["pnpm install*", "deny"], ["pnpm add*", "deny"], ["pnpm remove*", "deny"],
        ["yarn install*", "deny"], ["yarn add*", "deny"], ["yarn remove*", "deny"],
        ["bun install*", "deny"], ["bun add*", "deny"], ["bun remove*", "deny"],
        ["pip install*", "deny"], ["pip3 install*", "deny"], ["uv add*", "deny"], ["uv remove*", "deny"], ["uv sync*", "deny"],
        ["cargo add*", "deny"], ["cargo remove*", "deny"], ["go get*", "deny"], ["bundle install*", "deny"],
        ["composer install*", "deny"], ["composer require*", "deny"]
      ]
    },
    "ops-trusted-shell": {
      "description": "Broad operational access with confirmation for high-impact commands and denials for destructive actions.",
      "rules": [
        ["psql *", "ask"], ["mysql *", "ask"], ["mongosh *", "ask"], ["redis-cli *", "ask"],
        ["rm *", "ask"], ["* install*", "ask"],
        ["* submit*", "ask"], ["* push*", "ask"], ["* release create*", "ask"], ["* workflow run*", "ask"],
        ["* upgrade*", "ask"], ["* rollback*", "ask"], ["* patch*", "ask"], ["* scale*", "ask"], ["* rollout*", "ask"],
        ["telnet *", "ask"], ["mosh *", "ask"], ["socat *", "ask"], ["nmap *", "ask"],
        ["* rm *", "deny"], ["* delete*", "deny"], ["*--delete*", "deny"],
        ["* prune*", "deny"], ["* uninstall*", "deny"], ["* down -v*", "deny"], ["* terminate*", "deny"],
        ["terraform import*", "deny"], ["terraform * import*", "deny"],
        ["kubectl edit*", "deny"], ["kubectl * edit*", "deny"]
      ]
    },
    "git-read": {
      "description": "Read-only repository inspection; diff/log/show --output is denied.",
      "rules": [
        ["git status*", "allow"], ["git diff*", "allow"], ["git diff *--output*", "deny"],
        ["git log*", "allow"], ["git log *--output*", "deny"], ["git show*", "allow"], ["git show *--output*", "deny"],
        ["git ls-files*", "allow"], ["git grep*", "allow"], ["git shortlog*", "allow"], ["git describe*", "allow"],
        ["git reflog show*", "allow"], ["git stash list*", "allow"], ["git stash show*", "allow"],
        ["git worktree list*", "allow"], ["git tag -l*", "allow"], ["git tag --list*", "allow"],
        ["git remote -v*", "allow"], ["git config --get*", "allow"], ["git config --list*", "allow"],
        ["git check-ignore*", "allow"], ["git check-attr*", "allow"],
        ["git --no-pager status*", "allow"], ["git --no-pager diff*", "allow"], ["git --no-pager diff *--output*", "deny"],
        ["git --no-pager log*", "allow"], ["git --no-pager log *--output*", "deny"],
        ["git --no-pager show*", "allow"], ["git --no-pager show *--output*", "deny"],
        ["git --no-pager blame*", "allow"], ["git --no-pager branch*", "allow"],
        ["git --no-pager grep*", "allow"], ["git --no-pager ls-files*", "allow"],
        ["git -P status*", "allow"], ["git -P diff*", "allow"], ["git -P diff *--output*", "deny"],
        ["git -P log*", "allow"], ["git -P log *--output*", "deny"], ["git -P show*", "allow"], ["git -P show *--output*", "deny"],
        ["git -C * status*", "allow"], ["git -C * diff*", "allow"], ["git -C * diff *--output*", "deny"],
        ["git -C * log*", "allow"], ["git -C * log *--output*", "deny"],
        ["git -C * show*", "allow"], ["git -C * show *--output*", "deny"], ["git -C * rev-parse*", "allow"]
      ]
    },
    "shell-read": {
      "description": "Allow standard file and text inspection commands only.",
      "rules": [
        ["ls*", "allow"], ["pwd", "allow"], ["wc*", "allow"], ["head *", "allow"], ["tail *", "allow"],
        ["cat *", "allow"], ["stat *", "allow"], ["file *", "allow"], ["which *", "allow"], ["type *", "allow"],
        ["uname*", "allow"], ["whoami", "allow"], ["id", "allow"], ["date*", "allow"], ["rg *", "allow"],
        ["grep *", "allow"], ["egrep *", "allow"], ["fgrep *", "allow"], ["find *", "allow"], ["fd *", "allow"],
        ["jq *", "allow"], ["yq *", "allow"], ["tree*", "allow"], ["du *", "allow"], ["df*", "allow"],
        ["diff *", "allow"], ["sort *", "allow"], ["uniq*", "allow"], ["cut *", "allow"], ["tr *", "allow"],
        ["awk *", "allow"]
      ]
    },
    "shell-read-guard": {
      "description": "Deny file-writing redirects and executable flags in read utilities.",
      "rules": [
        ["* > *", "deny"], ["* >> *", "deny"], ["*>*", "deny"], ["*>>*", "deny"],
        ["find *-exec*", "deny"], ["find *-execdir*", "deny"], ["find *-delete*", "deny"], ["find *-ok*", "deny"],
        ["fd *-x*", "deny"], ["fd *-X*", "deny"], ["fd *--exec*", "deny"],
        ["sort *-o *", "deny"], ["sort *--output*", "deny"], ["sort -o*", "deny"], ["sort --output=*", "deny"],
        ["yq *-i*", "deny"], ["yq *--inplace*", "deny"],
        ["rg *--pre*", "deny"], ["awk *-f*", "deny"], ["awk *system*", "deny"], ["awk *getline*", "deny"]
      ]
    },
    "security-scanners": {
      "description": "Allow common dependency, source, secret, and filesystem security scanners.",
      "rules": [
        ["bandit*", "allow"], ["cargo audit*", "allow"], ["gitleaks*", "allow"], ["govulncheck*", "allow"],
        ["npm audit*", "allow"], ["osv-scanner scan*", "allow"], ["pip-audit*", "allow"], ["pnpm audit*", "allow"],
        ["semgrep scan*", "allow"], ["snyk test*", "allow"], ["trivy config*", "allow"], ["trivy fs*", "allow"],
        ["yarn npm audit*", "allow"], ["bun audit*", "allow"],
        ["npm audit --fix*", "deny"], ["pnpm audit --fix*", "deny"], ["yarn npm audit --fix*", "deny"], ["bun audit --fix*", "deny"]
      ]
    },
    "git-blame": {"description": "Line history.", "rules": [["git blame*", "allow"]]},
    "git-branch-name": {
      "description": "Inspect local and remote branch names.",
      "rules": [
        ["git branch --show-current*", "allow"], ["git branch -l*", "allow"], ["git branch --list*", "allow"],
        ["git branch -a*", "allow"], ["git branch --all*", "allow"], ["git branch -r*", "allow"],
        ["git branch --remotes*", "allow"], ["git branch -v*", "allow"], ["git branch -vv*", "allow"],
        ["git branch --contains*", "allow"], ["git branch --merged*", "allow"], ["git branch --no-merged*", "allow"]
      ]
    },
    "post-session-stage": {
      "description": "Stage explicit file paths only; mass, patch, and interactive staging are denied.",
      "rules": [
        ["git add *", "allow"], ["git add -A*", "deny"], ["git add --all*", "deny"],
        ["git add -u*", "deny"], ["git add --update*", "deny"], ["git add -p*", "deny"],
        ["git add --patch*", "deny"], ["git add -i*", "deny"], ["git add --interactive*", "deny"],
        ["git add .", "deny"], ["git add ./", "deny"], ["git add -- .", "deny"],
        ["git add */", "deny"], ["git add *.", "deny"], ["git rm --cached *", "allow"]
      ]
    },
    "post-session-template-stage": {
      "description": "Allow staging only an explicit safe environment template.",
      "rules": [
        ["git add .env.example", "allow"], ["git add .env.sample", "allow"],
        ["git add .env.template", "allow"], ["git add .env.test", "allow"]
      ]
    },
    "post-session-commit": {
      "description": "Allow only a quoted-message local commit; reject amend, all, and verification bypasses.",
      "rules": [
        ["git commit*", "deny"], ["git commit -m \"*\"", "allow"],
        ["git commit -a*", "deny"], ["git commit --all*", "deny"],
        ["git commit * --amend*", "deny"], ["git commit * --no-verify*", "deny"], ["git commit * --all*", "deny"]
      ]
    }
  },
  "roles": {
    "explorer": ["deny-all", "cd", "git-read", "shell-read", "shell-read-guard", "secrets-guard"],
    "code_reviewer": ["deny-all", "cd", "git-read", "shell-read", "shell-read-guard", "secrets-guard"],
    "critic": ["deny-all", "cd", "git-read", "shell-read", "shell-read-guard", "secrets-guard"],
    "hitl": ["deny-all", "cd", "git-read", "shell-read", "shell-read-guard", "secrets-guard"],
    "security_auditor": ["deny-all", "cd", "git-read", "shell-read", "shell-read-guard", "security-scanners", "secrets-guard"],
    "executor": ["allow-all", "privilege-and-host-guard", "secrets-guard", "secrets-copy", "secrets-copy-guard", "remote-and-cloud-ask", "publish-guard", "rm-guard", "pipeline-git-coding-guard"],
    "fast_lane": ["allow-all", "privilege-and-host-guard", "secrets-guard", "secrets-copy", "secrets-copy-guard", "remote-and-cloud-ask", "publish-guard", "rm-guard", "pipeline-git-coding-guard"],
    "refactorer": ["allow-all", "privilege-and-host-guard", "secrets-guard", "secrets-copy", "secrets-copy-guard", "remote-and-cloud-ask", "publish-guard", "rm-guard", "pipeline-git-coding-guard"],
    "tester": ["allow-all", "privilege-and-host-guard", "secrets-guard", "secrets-copy", "secrets-copy-guard", "remote-and-cloud-ask", "publish-guard", "rm-guard", "pipeline-git-coding-guard", "pipeline-git-tester-guard"],
    "ops": ["allow-all", "privilege-and-host-guard", "secrets-guard", "secrets-copy", "secrets-copy-guard", "ops-trusted-shell", "remote-and-cloud-ask", "publish-guard", "rm-guard", "ops-rm-guard"],
    "post_session": ["deny-all", "cd", "git-read", "git-blame", "git-branch-name", "post-session-stage", "post-session-commit", "secrets-guard", "post-session-template-stage"]
  }
}
