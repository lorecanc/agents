{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "enabled": true
        },
        "codebase-memory-mcp": {
            "type": "local",
            "command": [
                "codebase-memory-mcp"
            ],
            "enabled": true
        },
        "XcodeBuildMCP": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "xcodebuildmcp@latest",
                "mcp"
            ],
            "enabled": false
        },
        "shadcn": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "shadcn@latest",
                "mcp"
            ],
            "enabled": true
        },
        "magic": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@21st-dev/magic@latest"
            ],
            "environment": {
                "API_KEY": "{env:TWENTYFIRST_API_KEY}"
            },
            "enabled": true
        },
        "cupertino": {
            "type": "local",
            "command": [
                "cupertino",
                "serve"
            ],
            "enabled": false
        },
        "axiom": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "axiom-mcp"
            ],
            "enabled": true
        },
        "cwe-search": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "cwe-search-mcp@latest"
            ],
            "enabled": true
        }
    },
    "lsp": {
        "basedpyright": {
            "command": [
                "basedpyright-langserver",
                "--stdio"
            ],
            "extensions": [
                ".py"
            ]
        },
        "ruff": {
            "command": [
                "ruff",
                "server"
            ],
            "extensions": [
                ".py"
            ]
        },
        "html": {
            "command": [
                "vscode-html-language-server",
                "--stdio"
            ],
            "extensions": [
                ".html",
                ".htm",
                ".vue"
            ]
        },
        "css": {
            "command": [
                "vscode-css-language-server",
                "--stdio"
            ],
            "extensions": [
                ".css",
                ".scss",
                ".less"
            ]
        },
        "sql": {
            "command": [
                "sqls"
            ],
            "extensions": [
                ".sql"
            ]
        },
        "markdown": {
            "command": [
                "marksman",
                "server"
            ],
            "extensions": [
                ".md",
                ".mdx"
            ]
        }
    }
}
